# Ensure Docker BuildKit is on (required for cache mounts in Dockerfiles)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# --- Postgres ---
POSTGRES_USER=acm
POSTGRES_PASSWORD=acm_dev
POSTGRES_DB=acm
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=8000
# 32-byte URL-safe base64 string. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Either FERNET_KEY (single) OR FERNET_KEYS (comma-separated, primary first)
# must be set. Use FERNET_KEYS for zero-downtime key rotation:
#     FERNET_KEYS=<newly_generated>,<previous>
# New writes encrypt under the first key; old ciphertext still decrypts via
# the second. After re-encrypting existing rows you can drop the old key.
FERNET_KEY=replace_me_with_generated_fernet_key
# FERNET_KEYS=

# Random secret for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_random_secret
JWT_ALG=HS256
# Access-token lifetime in minutes. 1440 = 1 day (default in code, also
# repeated here for visibility). Drop this lower if your security
# policy requires shorter sessions.
JWT_EXPIRE_MINUTES=1440
# Comma-separated list of origins allowed to call the API (no trailing slash)
CORS_ORIGINS=http://localhost:3010

# --- Logging ---
# `pretty` (default, human-friendly text in dev) or `json` (one record per
# line, machine-readable; for log shippers / search). The prod compose sets
# this to `json` automatically — leave blank in dev unless you want to
# preview JSON logs locally.
LOG_FORMAT=pretty
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Sentry (optional) ---
# Leave SENTRY_DSN empty to disable. Set to ship errors to Sentry or to a
# self-hosted GlitchTip (Sentry-API-compatible).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0–1.0. 0 disables performance tracing (errors still ship).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Bootstrap admin (used by `python -m app.seed`) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme_strong_password
BOOTSTRAP_ADMIN_NAME=Admin
# Set to "true" once if you want re-running the seed to reset the admin password.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# --- Web ---
# WEB_PORT only used by the dev compose file; in production web is reached
# through Caddy on 443.
WEB_PORT=3010
# Used by the DEV compose for `next dev` runtime. Full URL to the api host.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by the PROD compose as a build-arg for `next build`. Default `/api`
# resolves same-origin under ${ACM_HOSTNAME} via the Caddy reverse proxy.
# Set this only if api and web live on different origins in production.
ACM_PUBLIC_API_URL=/api

# --- Reverse proxy / TLS (used by docker-compose.prod.yml only) ---
# Public hostname users will browse to. Defaults to "localhost" which makes
# Caddy issue a self-signed cert from its built-in local CA.
# For a real internal deploy: set this to the DNS name pointed at the host,
# e.g. ACM_HOSTNAME=acm.internal.example.com — Caddy will then auto-fetch a
# Let's Encrypt cert (provided port 80 is reachable from the public internet).
# For internal-only domains (no public DNS), add `tls internal` to your local
# Caddyfile inside the site block.
ACM_HOSTNAME=localhost
# Used for Let's Encrypt account registration. Strongly recommended.
ACM_LETSENCRYPT_EMAIL=admin@example.com

# --- CSV ingest API (machine-to-machine) ---
# Shared secret for POST /ingest/csv-tables (sent as `X-Api-Key: <key>` or
# `Authorization: Bearer <key>`). LEAVE BLANK to keep the endpoint DISABLED
# (503). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CSV_INGEST_API_KEY=
# Optional. Leave these COMMENTED OUT unless used — an empty value (e.g.
# CSV_INGEST_OWNER_ID=) fails int parsing and would stop the API booting.
# User id that owns ingested tables (else no owner; admins/managers see all):
# CSV_INGEST_OWNER_ID=1
# Library folder id ingested tables land in (else root):
# CSV_INGEST_FOLDER_ID=5
